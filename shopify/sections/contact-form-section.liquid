{% comment %}
  Contact Form Section - Form and contact information
{% endcomment %}

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      {%- comment -%} Contact Form {%- endcomment -%}
      <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12">
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-flores-primary mb-4 font-heading">
            {{ section.settings.form_title | default: 'Send us a Message' }}
          </h2>
          <p class="text-gray-600 font-body">
            {{ section.settings.form_subtitle | default: "Have a question or want to start a conversation? We'd love to hear from you." }}
          </p>
        </div>

        {%- form 'contact', class: 'space-y-6' -%}
          {%- if form.posted_successfully? -%}
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <p class="text-green-800 font-medium">
                {{ 'contact.form.post_success' | t }}
              </p>
            </div>
          {%- elsif form.errors -%}
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <p class="text-red-800 font-medium">
                {{ form.errors | default_errors }}
              </p>
            </div>
          {%- endif -%}

          {%- comment -%} Inquiry Type {%- endcomment -%}
          <div>
            <label for="contact-type" class="block text-sm font-semibold text-gray-700 mb-2">
              Inquiry Type
            </label>
            <select
              id="contact-type"
              name="contact[inquiry-type]"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-flores-primary focus:border-transparent transition-colors"
            >
              <option value="general">General Information</option>
              <option value="wholesale">Wholesale & B2B</option>
              <option value="export">Export Inquiries</option>
              <option value="partnership">Partnership Opportunities</option>
              <option value="media">Media & Press</option>
            </select>
          </div>

          {%- comment -%} Name and Email Row {%- endcomment -%}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="contact-name" class="block text-sm font-semibold text-gray-700 mb-2">
                Your Name *
              </label>
              <input
                type="text"
                id="contact-name"
                name="contact[name]"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-flores-primary focus:border-transparent transition-colors"
                placeholder="John Doe"
                required
              >
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-semibold text-gray-700 mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="contact-email"
                name="contact[email]"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-flores-primary focus:border-transparent transition-colors"
                placeholder="john@example.com"
                required
              >
            </div>
          </div>

          {%- comment -%} Subject {%- endcomment -%}
          <div>
            <label for="contact-subject" class="block text-sm font-semibold text-gray-700 mb-2">
              Subject *
            </label>
            <input
              type="text"
              id="contact-subject"
              name="contact[subject]"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-flores-primary focus:border-transparent transition-colors"
              placeholder="How can we help you?"
              required
            >
          </div>

          {%- comment -%} Message {%- endcomment -%}
          <div>
            <label for="contact-message" class="block text-sm font-semibold text-gray-700 mb-2">
              Message *
            </label>
            <textarea
              id="contact-message"
              name="contact[body]"
              rows="6"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-flores-primary focus:border-transparent transition-colors resize-none"
              placeholder="Tell us more about your inquiry..."
              required
            ></textarea>
          </div>

          {%- comment -%} Submit Button {%- endcomment -%}
          <button
            type="submit"
            class="w-full py-4 px-8 rounded-lg font-semibold transition-colors duration-300 bg-flores-primary text-white hover:bg-flores-primary/90"
          >
            Send Message
          </button>
        {%- endform -%}
      </div>

      {%- comment -%} Contact Information {%- endcomment -%}
      <div class="space-y-8">
        <div class="text-center lg:text-left">
          <h2 class="text-3xl font-bold text-flores-primary mb-4 font-heading">
            {{ section.settings.info_title | default: 'Contact Information' }}
          </h2>
          <p class="text-gray-600 font-body text-lg">
            {{ section.settings.info_subtitle | default: 'Multiple ways to reach us. Choose what works best for you.' }}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-6">
          {%- for block in section.blocks -%}
            {%- if block.type == 'contact_info' -%}
              <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300" {{ block.shopify_attributes }}>
                <div class="flex items-start space-x-4">
                  <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-flores-primary/10 rounded-lg flex items-center justify-center">
                      {%- case block.settings.icon -%}
                        {%- when 'email' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                          </svg>
                        {%- when 'phone' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                          </svg>
                        {%- when 'location' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                          </svg>
                        {%- when 'clock' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        {%- when 'building' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                          </svg>
                        {%- when 'globe' -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                          </svg>
                        {%- else -%}
                          <svg class="w-6 h-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                          </svg>
                      {%- endcase -%}
                    </div>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900 mb-2 font-heading">
                      {{ block.settings.title }}
                    </h3>
                    <div class="space-y-1 mb-2">
                      <p class="text-flores-primary font-medium">
                        {{ block.settings.detail_1 }}
                      </p>
                      {%- if block.settings.detail_2 != blank -%}
                        <p class="text-flores-primary font-medium">
                          {{ block.settings.detail_2 }}
                        </p>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.description != blank -%}
                      <p class="text-gray-600 text-sm font-body">
                        {{ block.settings.description }}
                      </p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form Section",
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Send us a Message"
    },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Form subtitle"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Info section title",
      "default": "Contact Information"
    },
    {
      "type": "text",
      "id": "info_subtitle",
      "label": "Info section subtitle"
    }
  ],
  "blocks": [
    {
      "type": "contact_info",
      "name": "Contact Info",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "email", "label": "Email"},
            {"value": "phone", "label": "Phone"},
            {"value": "location", "label": "Location"},
            {"value": "clock", "label": "Clock"},
            {"value": "globe", "label": "Globe"},
            {"value": "building", "label": "Building/Office"}
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "detail_1",
          "label": "Detail 1"
        },
        {
          "type": "text",
          "id": "detail_2",
          "label": "Detail 2"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Form Section",
      "blocks": [
        {
          "type": "contact_info",
          "settings": {
            "icon": "email",
            "title": "General Inquiries",
            "detail_1": "admin@flores.coffee",
            "description": "For general questions and information"
          }
        },
        {
          "type": "contact_info",
          "settings": {
            "icon": "location",
            "title": "Our Location",
            "detail_1": "Maumere, Flores Island",
            "detail_2": "East Nusa Tenggara, Indonesia"
          }
        }
      ]
    }
  ]
}
{% endschema %}
