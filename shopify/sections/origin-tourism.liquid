<section class="bg-white py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="text-center mb-8 leading-relaxed md:leading-[33px] md:text-4xl font-extrabold flores-heading text-flores-primary">
      {{ section.settings.tourism_title }}
    </h2>
    <div class="mb-8">
      {%- if section.settings.tourism_image != blank -%}
        <img
          src="{{ section.settings.tourism_image | img_url: '1920x' }}"
          alt="{{ section.settings.tourism_image_alt }}"
          class="w-full rounded-lg shadow-lg"
        />
      {%- endif -%}
    </div>
    <div class="space-y-4 max-w-5xl mx-auto">
      <p class="text-base md:text-lg leading-relaxed text-[#476472] font-body">
        {{ section.settings.tourism_paragraph_1 }}
      </p>
      <p class="text-base md:text-lg leading-relaxed text-[#476472] font-body">
        {{ section.settings.tourism_paragraph_2 }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Origin Tourism",
  "settings": [
    {
      "type": "text",
      "id": "tourism_title",
      "label": "Tourism Title",
      "default": "Tourism Snapshot"
    },
    {
      "type": "image_picker",
      "id": "tourism_image",
      "label": "Tourism Image"
    },
    {
      "type": "text",
      "id": "tourism_image_alt",
      "label": "Tourism Image Alt Text",
      "default": "Tourism Snapshot"
    },
    {
      "type": "textarea",
      "id": "tourism_paragraph_1",
      "label": "Tourism Paragraph 1",
      "default": "Flores island is visually extraordinary and showcases the world-famous Komodo National Park, a UNESCO World Heritage site, multi-coloured volcanic lakes, pristine waterfalls, uninhabited islands, and pristine reefs. Unique agriculture, like the spider web rice fields of Cancar and shade grown plantations of coffee, cacao, coconut, the island wide cultivation of aromatic spices contribute to a strong cultural and culinary heritage."
    },
    {
      "type": "textarea",
      "id": "tourism_paragraph_2",
      "label": "Tourism Paragraph 2",
      "default": "The island's stunning rugged coastline, islands, pristine waters and marine life make it a paradise for liveaboard cruising, sea kayaking, diving and snorkelling. Easy access to cultural immersion provides a deeper understanding of Flores' rich heritage and offers meaningful connections with its warm-hearted people."
    }
  ],
  "presets": [
    {
      "name": "Origin Tourism"
    }
  ]
}
{% endschema %}
