{% comment %}
  Featured Products Section - Homepage preview showing 3 latest products
  Displays products with "See More Products" button
{% endcomment %}

{%- liquid
  if section.settings.collection != blank
    assign current_collection = collections[section.settings.collection]
  else
    assign current_collection = collections.all
  endif
-%}

<section class="min-h-screen flex items-center justify-center bg-white px-4 sm:px-6 lg:px-8 pt-12 md:pt-16 lg:pt-20 pb-12 md:pb-16 lg:pb-20">
  <div class="max-w-7xl mx-auto w-full">
    <h2 class="leading-relaxed md:leading-[33px] md:text-4xl font-extrabold text-flores-primary mt-8 md:mt-12 mb-12 font-heading text-center">
      {{ section.settings.title | default: 'Our Signature Coffee Product' }}
    </h2>
  
  {%- if current_collection.products_count > 0 -%}
    {%- comment -%} Products Grid - Show only 3 latest {%- endcomment -%}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12 md:mb-16">
      {%- for product in current_collection.products limit: 3 -%}
        <a href="{{ product.url }}" class="group cursor-pointer">
          <div class="bg-[#D4E8E8] rounded-2xl p-8 mb-4 flex items-center justify-center h-[280px] group-hover:bg-[#c0dada] transition-colors">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | img_url: '800x800' }}"
                alt="{{ product.title }}"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              >
            {%- else -%}
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-16 h-16 text-flores-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
            {%- endif -%}
          </div>
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-xl font-bold text-flores-primary mb-1 font-heading group-hover:text-flores-accent transition-colors">
                {{ product.title }}
              </h3>
              {%- if product.vendor -%}
                <p class="text-lg text-flores-primary/80 font-body">
                  {{ product.vendor }}
                </p>
              {%- endif -%}
            </div>
            <div class="text-2xl font-bold text-flores-primary font-heading">
              {{ product.price | money }}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%} See More Products Button {%- endcomment -%}
    <div class="text-center">
      <a 
        href="{{ section.settings.collection_url | default: '/collections/all' }}" 
        class="inline-block px-8 py-3 bg-flores-primary text-white rounded-full font-semibold hover:bg-flores-primary/90 transition-colors font-body"
      >
        {{ section.settings.button_text | default: 'See More Products' }}
      </a>
    </div>

  {%- else -%}
    {%- comment -%} Empty State {%- endcomment -%}
    <div class="text-center py-16">
      <svg class="w-20 h-20 mx-auto mb-6 text-flores-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
      </svg>
      <h2 class="text-2xl font-bold text-flores-primary mb-3 font-heading">No products in this collection</h2>
      <p class="text-gray-600 font-body">Check back soon for our latest products.</p>
    </div>
  {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select which collection to display. Defaults to all products."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Signature Coffee Product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "See More Products"
    },
    {
      "type": "url",
      "id": "collection_url",
      "label": "Collection Page URL",
      "info": "URL for the button. Leave empty to use /collections/all"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
