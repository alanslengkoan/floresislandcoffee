{% comment %}
  About Methodology Section - 4-step methodology
{% endcomment %}

<section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center">
      <h2 class="text-xl lg:text-4xl xl:text-5xl font-serif text-slate-700 mb-4 lg:mb-12 font-light">
        {{ section.settings.title | default: 'Methodology' }}
      </h2>
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 auto-rows-fr">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="flex flex-col" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="mb-4">
                  <img 
                    src="{{ block.settings.image | img_url: '400x400' }}" 
                    alt="{{ block.settings.alt | default: 'Methodology step' }}" 
                    width="400"
                    height="400"
                    class="w-full h-auto object-cover rounded-lg"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <p class="text-sm text-slate-700 leading-relaxed">
                {{ block.settings.description }}
              </p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Methodology",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Methodology"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Methodology Step",
      "settings": [
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Methodology",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "description": "Implement a sustainability KPI system (FESS) to improve farming practices, boost productivity, and strengthen farmer livelihoods."
          }
        },
        {
          "type": "step",
          "settings": {
            "description": "Establish a near-source, high-tech processing facility to add value, ensure traceability, and reduce supply chain emissions."
          }
        },
        {
          "type": "step",
          "settings": {
            "description": "Develop bulk high-quality cold brew concentrate for global B2B supply using coffee as the core ingredient."
          }
        },
        {
          "type": "step",
          "settings": {
            "description": "Partner with local and international organizations to enhance farm-level yield and quality across Flores Island."
          }
        }
      ]
    }
  ]
}
{% endschema %}
