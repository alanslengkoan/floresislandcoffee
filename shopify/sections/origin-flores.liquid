<section class="py-16 md:py-20 flex justify-center">
  <div class="max-w-7xl mx-auto px-6 md:px-12 bg-[#E8F4F4] rounded-lg py-12 md:py-16">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        {%- if section.settings.flores_image != blank -%}
          <img
            src="{{ section.settings.flores_image | img_url: '800x' }}"
            alt="{{ section.settings.flores_image_alt }}"
            class="w-full rounded-lg shadow-lg"
          />
        {%- endif -%}
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-flores-primary mb-6 font-heading">
          {{ section.settings.flores_title }}
        </h2>
        <div class="space-y-4">
          <p class="text-base md:text-lg leading-relaxed text-[#476472] font-body">
            {{ section.settings.flores_description }}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Origin Flores Island",
  "settings": [
    {
      "type": "text",
      "id": "flores_title",
      "label": "Flores Island Title",
      "default": "Flores Island"
    },
    {
      "type": "textarea",
      "id": "flores_description",
      "label": "Flores Island Description",
      "default": "The name Flores is from \"Cabo de Flores\" - Cape of Flowers - used by Portuguese sailors in the 17th century. 570 kms long and located 300 kms to the east of Bali, Flores is home to exotic tropical fruits, spices and creatures, high mountain ranges and volcanoes surrounded by some of the world's best coral reefs. Flores Island is populated by various ethnic groups with their own traditions and languages within a total island wide population of around 2 million."
    },
    {
      "type": "image_picker",
      "id": "flores_image",
      "label": "Flores Island Image"
    },
    {
      "type": "text",
      "id": "flores_image_alt",
      "label": "Flores Image Alt Text",
      "default": "Flores Island"
    }
  ],
  "presets": [
    {
      "name": "Origin Flores Island"
    }
  ]
}
{% endschema %}
