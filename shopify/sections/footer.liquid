{% comment %}
  Footer Section - Converted from RootLayout.jsx
  Footer with company info and links
{% endcomment %}

<footer class="min-h-[50vh] flex items-center bg-flores-footer text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
    {%- comment -%} Center the 3-column group and top-align items {%- endcomment -%}
    <div class="flex flex-col md:flex-row md:justify-center md:items-start md:gap-24">

      {%- comment -%} Left Column - Logo and Contact {%- endcomment -%}
      <div class="md:w-96 space-y-20">
        <div>
          {%- if section.settings.footer_logo != blank -%}
            <img 
              src="{{ section.settings.footer_logo | img_url: 'medium' }}" 
              alt="{{ shop.name }}" 
              class="h-26 w-auto"
              loading="lazy"
            >
          {%- else -%}
            <span class="text-3xl font-bold text-white font-heading">{{ shop.name }}</span>
          {%- endif -%}
        </div>

        <div class="space-y-2 mb-6">
          {%- comment -%} Email Contact {%- endcomment -%}
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-white/60" fill="currentColor" viewBox="0 0 24 24">
              <path d="M2.25 4.5h19.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H2.25a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75zm0 1.5v.38l9.75 6.37 9.75-6.37v-.38H2.25zm0 12h19.5V7.12l-9.14 5.97a.75.75 0 0 1-.82 0L2.25 7.12V18z" />
            </svg>
            <p class="text-white font-body text-lg">{{ section.settings.email_general | default: 'admin@flores.coffee' }}</p>
          </div>
        </div>
      </div>

      {%- comment -%} Middle Column - Links {%- endcomment -%}
      <div class="md:w-64 mt-8 md:mt-0">
        <h3 class="text-3xl font-bold text-white mb-8 font-heading">
          Flores Island<br>Coffee
        </h3>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-white/80 hover:text-white transition-colors font-body text-lg">
              Home
            </a>
          </li>
          <li>
            <a href="/pages/about" class="text-white/80 hover:text-white transition-colors font-body text-lg">
              About
            </a>
          </li>
          <li>
            <a href="/pages/partnerships" class="text-white/80 hover:text-white transition-colors font-body text-lg">
              Partnership
            </a>
          </li>
          <li>
            <a href="/pages/origin" class="text-white/80 hover:text-white transition-colors font-body text-lg">
              Origin
            </a>
          </li>
          <li>
            <a href="/pages/wholesale-enquiry" class="text-white/80 hover:text-white transition-colors font-body text-lg">
              Wholesale Enquiries
            </a>
          </li>
        </ul>
      </div>

      {%- comment -%} Right Column - Socials {%- endcomment -%}
      <div class="md:w-56 mt-8 md:mt-0">
        <h3 class="text-3xl font-bold text-white mb-8 font-heading">
          We Are<br>Socials
        </h3>
        <ul class="space-y-2">
          {%- if section.settings.facebook_url != blank -%}
            <li>
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" class="text-white/80 hover:text-white transition-colors font-body text-lg">
                Facebook
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <li>
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="text-white/80 hover:text-white transition-colors font-body text-lg">
                Instagram
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <li>
              <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" class="text-white/80 hover:text-white transition-colors font-body text-lg">
                Twitter
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    {%- comment -%} Divider + copyright {%- endcomment -%}
    <div class="border-t border-white/20 mt-12 pt-8">
      <p class="text-white/60 text-base font-body">
        &copy;{{ 'now' | date: '%Y' }} All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "email_general",
      "label": "General Email",
      "default": "admin@flores.coffee"
    },
    {
      "type": "text",
      "id": "email_indonesian",
      "label": "Indonesian Enquiry Email",
      "default": "contact@flores.coffee"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    }
  ]
}
{% endschema %}
