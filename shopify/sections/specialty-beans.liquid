{% comment %}
  Specialty Beans Section - Signature roasted beans
{% endcomment %}

<section class="py-12 md:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 md:px-6 text-center mb-2 md:mb-4">
    <h2 class="text-2xl md:text-4xl font-bold text-flores-primary mb-1 md:mb-2 font-heading">
      {{ section.settings.title | default: 'Our Signature Beans' }}
    </h2>
    <p class="text-sm md:text-lg font-extrabold font-heading">
      {{ section.settings.subtitle | default: 'Available for B2B inquiries and custom Houseblend requests.' }}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 mb-8 md:mb-12">
    {%- for block in section.blocks -%}
      {%- if block.type == 'specialty_card' -%}
        <div class="relative h-[15rem] md:h-[26rem] w-full overflow-hidden group text-white" {{ block.shopify_attributes }}>
          {%- comment -%} Default Image {%- endcomment -%}
          {%- if block.settings.image != blank -%}
            <img 
              src="{{ block.settings.image | img_url: '1200x800' }}" 
              alt="{{ block.settings.alt | default: block.settings.title | escape }}"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:translate-x-full"
              loading="lazy"
            >
          {%- endif -%}

          {%- comment -%} Hover Image - slides in from left {%- endcomment -%}
          {%- if block.settings.hover_image != blank -%}
            <img 
              src="{{ block.settings.hover_image | img_url: '1200x800' }}" 
              alt="{{ block.settings.alt | default: block.settings.title | escape }}"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-in-out -translate-x-full group-hover:translate-x-0"
              loading="lazy"
            >
          {%- endif -%}

          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-transparent"></div>

          <div class="relative z-10 flex h-full flex-col items-center justify-end p-4 md:p-8 text-center">
            <h3 class="text-3xl md:text-5xl font-semibold mb-3 md:mb-4">
              {{ block.settings.title }}
            </h3>
            <div class="flex flex-wrap justify-center gap-2 md:gap-4">
              <button class="border border-white rounded-md px-3 md:px-5 py-1.5 md:py-2 text-xs md:text-sm font-medium transition-colors hover:bg-white hover:text-black">
                Dry Hulled
              </button>
              <button class="border border-white rounded-md px-3 md:px-5 py-1.5 md:py-2 text-xs md:text-sm font-medium transition-colors hover:bg-white hover:text-black">
                Wet Hulled
              </button>
              <button class="border border-white rounded-md px-3 md:px-5 py-1.5 md:py-2 text-xs md:text-sm font-medium transition-colors hover:bg-white hover:text-black">
                Honey
              </button>
              <button class="border border-white rounded-md px-3 md:px-5 py-1.5 md:py-2 text-xs md:text-sm font-medium transition-colors hover:bg-white hover:text-black">
                Natural
              </button>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Specialty Beans",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Signature Flores Roasted Beans"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Available for B2B inquiries and custom Houseblend requests."
    }
  ],
  "blocks": [
    {
      "type": "specialty_card",
      "name": "Specialty Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Default Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover Image",
          "info": "Image that slides in from left on hover"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specialty Beans"
    }
  ]
}
{% endschema %}
