{% comment %}
  Newsletter Signup Section from Home.jsx
  Email subscription form
{% endcomment %}

<section class="min-h-[50vh] flex items-center justify-center bg-slate-100 py-12 md:py-16 lg:py-20">
  <div class="max-w-4xl mx-auto px-6 text-center w-full">
    <h2 class="text-5xl font-bold text-flores-primary mb-4">
      {{ section.settings.title | default: 'Stay Updated' }}
    </h2>
    <p class="text-lg text-gray-600 mb-10 mx-auto">
      {{ section.settings.description | default: 'Subscribe to our newsletter to be in the know about latest updates from Flores Island Coffee' }}
    </p>
    
    <form method="post" action="/contact#newsletter-form" id="newsletter-form" accept-charset="UTF-8" class="flex flex-col sm:flex-row justify-center items-center gap-4 max-w-lg mx-auto newsletter-form">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
        class="w-full px-5 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-800"
        required
        autocomplete="email"
      >
      <button
        type="submit"
        class="w-full sm:w-auto bg-flores-primary text-white font-semibold px-8 py-3 rounded-md hover:bg-gray-700 transition-colors duration-300"
      >
        {{ section.settings.button_text | default: 'Subscribe' }}
      </button>
    </form>
    
    <div id="newsletter-success" class="mt-4 hidden">
      <p class="text-green-600 font-medium">{{ section.settings.success_message | default: 'Thank you for subscribing!' }}</p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('.newsletter-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(form);
        
        fetch('/contact', {
          method: 'POST',
          body: formData
        })
        .then(response => response.text())
        .then(data => {
          form.reset();
          document.getElementById('newsletter-success').classList.remove('hidden');
          setTimeout(() => {
            document.getElementById('newsletter-success').classList.add('hidden');
          }, 5000);
        })
        .catch(error => {
          console.error('Error:', error);
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Newsletter Signup",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Stay Updated"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to our newsletter to be in the know about latest updates from Flores Island Coffee"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
