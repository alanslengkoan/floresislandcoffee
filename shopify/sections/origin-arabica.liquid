<section class="py-16 md:py-20 flex justify-center">
  <div class="max-w-7xl mx-auto px-6 md:px-12 bg-[#E8F4F4] rounded-lg py-12 md:py-16">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-flores-primary mb-8 font-heading">
          {{ section.settings.arabica_title }}
        </h2>
        <div class="grid grid-cols-2 gap-4">
          {% assign varieties = section.settings.arabica_varieties | split: "," %}
          {% for variety in varieties %}
            <div class="flex items-center gap-3 bg-white p-3 rounded-lg shadow-sm">
              <div class="w-6 h-6 rounded-full bg-flores-primary flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-sm md:text-base text-flores-primary font-body">{{ variety }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
      <div>
        {%- if section.settings.arabica_image != blank -%}
          <img
            src="{{ section.settings.arabica_image | img_url: '800x' }}"
            alt="{{ section.settings.arabica_image_alt }}"
            class="w-full rounded-lg shadow-lg"
          />
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Origin Arabica Varieties",
  "settings": [
    {
      "type": "text",
      "id": "arabica_title",
      "label": "Arabica Varieties Title",
      "default": "Common Arabica Varieties"
    },
    {
      "type": "textarea",
      "id": "arabica_varieties",
      "label": "Arabica Varieties (comma separated)",
      "default": "Abyssinia,S-795,Ateng,Typica,Sigararutang,Andungsari,Catimors,Tim-Tim (Timor Hybrid)",
      "info": "Separate each variety with a comma"
    },
    {
      "type": "image_picker",
      "id": "arabica_image",
      "label": "Arabica Varieties Image"
    },
    {
      "type": "text",
      "id": "arabica_image_alt",
      "label": "Arabica Image Alt Text",
      "default": "Coffee Varieties"
    }
  ],
  "presets": [
    {
      "name": "Origin Arabica Varieties"
    }
  ]
}
{% endschema %}
