{% comment %}
  Coffee Harvest Section from Home.jsx
  Full-width background image with text overlay
{% endcomment %}

<section
  class="h-screen bg-cover md:bg-cover bg-center flex items-center bg-no-repeat"
  style="background-image: linear-gradient(to right, rgba(0,0,0,0.5), transparent), url({{ section.settings.background_image | img_url: '2048x2048' }}); background-size: cover;"
>
  <div class="w-full max-w-7xl mx-auto px-6 md:mt-96 mt-0">
    <h2 class="text-3xl md:text-5xl font-bold max-w-2xl text-white">
      {{ section.settings.title | default: 'The best product <br />from Flores Island Coffee' }}
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "Coffee Harvest",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title (HTML allowed)",
      "default": "The best product <br />from Flores Island Coffee"
    }
  ],
  "presets": [
    {
      "name": "Coffee Harvest"
    }
  ]
}
{% endschema %}
