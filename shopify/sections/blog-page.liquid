{% comment %}
  Blog Page Section - Matching News.jsx structure exactly
  Features: Featured section, Large cards, Latest articles
{% endcomment %}

{%- liquid
  if template == 'blog'
    assign current_blog = blog
  elsif section.settings.blog != blank
    assign current_blog = blogs[section.settings.blog]
  else
    assign current_blog = blogs['news']
  endif
-%}

{%- paginate current_blog.articles by 10 -%}
<div class="min-h-screen bg-white">
  {%- if current_blog.articles_count > 0 -%}
    {%- assign articles_array = current_blog.articles -%}
    
    {%- comment -%} Featured Section {%- endcomment -%}
    <section class="bg-cyan-50 py-16">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          {%- comment -%} Featured Main Article {%- endcomment -%}
          {%- if articles_array[0] -%}
            {%- assign featured_main = articles_array[0] -%}
            <a href="{{ featured_main.url }}" class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow group">
              <div class="p-6">
                {%- comment -%} Author Badge {%- endcomment -%}
                <div class="flex items-center gap-2">
                  <div class="bg-teal-700 text-white rounded-full px-3 py-1 flex items-center gap-2">
                    <div class="w-6 h-6 bg-teal-600 rounded-full flex items-center justify-center">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium">{{ featured_main.author | default: "Admin" }}</span>
                  </div>
                </div>
                
                <h2 class="text-4xl font-serif font-bold text-teal-800 mt-6 mb-4 group-hover:text-teal-700 transition-colors">
                  {{ featured_main.title }}
                </h2>
                <p class="text-sm text-gray-500 mb-6">{{ featured_main.published_at | date: '%B %d, %Y' }}</p>
                
                <div class="relative">
                  {%- if featured_main.image -%}
                    <img src="{{ featured_main.image | img_url: '800x' }}" alt="{{ featured_main.title }}" class="w-full h-80 object-cover rounded-xl group-hover:scale-[1.02] transition-transform duration-300" loading="lazy">
                  {%- else -%}
                    <div class="w-full h-80 bg-gradient-to-br from-teal-100 to-cyan-100 rounded-xl"></div>
                  {%- endif -%}
                </div>
              </div>
            </a>
          {%- endif -%}
          
          {%- comment -%} Featured Side Articles {%- endcomment -%}
          <div class="space-y-6">
            {%- for i in (1..3) -%}
              {%- assign side_article = articles_array[i] -%}
              {%- if side_article -%}
                <a href="{{ side_article.url }}" class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-shadow block group">
                  <div class="grid grid-cols-3 gap-4 p-5">
                    <div class="col-span-2">
                      <h3 class="text-xl font-serif font-bold text-teal-800 mb-2 group-hover:text-teal-700 transition-colors">
                        {{ side_article.title }}
                      </h3>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                        {{ side_article.excerpt_or_content | strip_html | truncatewords: 15 }}
                      </p>
                      <p class="text-xs text-gray-500">{{ side_article.published_at | date: '%B %d, %Y' }}</p>
                    </div>
                    <div>
                      {%- if side_article.image -%}
                        <img src="{{ side_article.image | img_url: '400x' }}" alt="{{ side_article.title }}" class="w-full h-32 object-cover rounded-lg group-hover:scale-[1.02] transition-transform duration-300" loading="lazy">
                      {%- else -%}
                        <div class="w-full h-32 bg-gradient-to-br from-teal-100 to-cyan-100 rounded-lg"></div>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} Large Featured Cards Section {%- endcomment -%}
    <section class="py-16 bg-cyan-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {%- for i in (4..5) -%}
            {%- assign large_article = articles_array[i] -%}
            {%- if large_article -%}
              <a href="{{ large_article.url }}" class="relative h-96 rounded-2xl overflow-hidden shadow-lg group">
                {%- if large_article.image -%}
                  <img src="{{ large_article.image | img_url: '1200x' }}" alt="{{ large_article.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
                {%- else -%}
                  <div class="w-full h-full bg-gradient-to-br from-teal-600 to-cyan-600"></div>
                {%- endif -%}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8">
                  <h3 class="text-3xl font-serif font-bold text-white">
                    {{ large_article.title }}
                  </h3>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} Latest Articles Section {%- endcomment -%}
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex justify-between items-center mb-12">
          <h2 class="text-4xl font-serif font-bold text-teal-800">Latest Articles</h2>
          <a href="{{ current_blog.url }}" class="text-teal-700 hover:text-teal-800 font-medium">
            See All
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {%- for i in (6..9) -%}
            {%- assign latest_article = articles_array[i] -%}
            {%- if latest_article -%}
              <a href="{{ latest_article.url }}" class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow group">
                {%- if latest_article.image -%}
                  <img src="{{ latest_article.image | img_url: '600x' }}" alt="{{ latest_article.title }}" class="w-full h-48 object-cover group-hover:scale-[1.02] transition-transform duration-300" loading="lazy">
                {%- else -%}
                  <div class="w-full h-48 bg-gradient-to-br from-teal-100 to-cyan-100"></div>
                {%- endif -%}
                <div class="p-6">
                  {%- comment -%} Author Badge {%- endcomment -%}
                  <div class="flex items-center gap-2">
                    <div class="bg-teal-700 text-white rounded-full px-3 py-1 flex items-center gap-2">
                      <div class="w-6 h-6 bg-teal-600 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <span class="text-xs font-medium">{{ latest_article.author | default: "Admin" }}</span>
                    </div>
                  </div>
                  <h3 class="text-xl font-serif font-bold text-teal-800 mt-4 mb-2 group-hover:text-teal-700 transition-colors">
                    {{ latest_article.title }}
                  </h3>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    {%- comment -%} Pagination {%- endcomment -%}
    {%- if paginate.pages > 1 -%}
      <section class="py-12 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <nav class="flex justify-center items-center gap-2" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="px-6 py-3 bg-white border-2 border-teal-700 text-teal-700 rounded-full font-semibold hover:bg-teal-700 hover:text-white transition-colors">
                ← Previous
              </a>
            {%- endif -%}

            <div class="flex gap-2">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-gray-300 rounded-full hover:border-teal-700 transition-colors">
                    {{ part.title }}
                  </a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="w-12 h-12 flex items-center justify-center bg-teal-700 text-white border-2 border-teal-700 rounded-full font-bold">
                    {{ part.title }}
                  </span>
                {%- else -%}
                  <span class="w-12 h-12 flex items-center justify-center text-gray-400">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="px-6 py-3 bg-teal-700 text-white rounded-full font-semibold hover:bg-teal-800 transition-colors">
                Next →
              </a>
            {%- endif -%}
          </nav>
        </div>
      </section>
    {%- endif -%}

  {%- else -%}
    {%- comment -%} Empty State {%- endcomment -%}
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center py-16">
          <svg class="w-20 h-20 mx-auto mb-6 text-teal-700/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <h2 class="text-2xl font-bold text-teal-800 mb-3 font-serif">No articles yet</h2>
          <a href="{{ current_blog.url }}" class="inline-flex items-center bg-teal-700 text-white px-8 py-3 rounded-full font-semibold hover:bg-teal-800 transition-colors">
            Browse All Articles
          </a>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Page",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select which blog to display. Leave empty to use 'news' blog."
    }
  ]
}
{% endschema %}
