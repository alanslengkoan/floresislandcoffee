{% comment %}
  Blog Page Section - Full blog listing with pagination
  Based on coffee-news.liquid styling
{% endcomment %}

{%- paginate blog.articles by 9 -%}
<div class="bg-white">
  {%- comment -%} Hero Section {%- endcomment -%}
  <section class="relative bg-white px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <div class="max-w-7xl mx-auto">
      <div class="rounded-3xl overflow-hidden relative" style="background-image: url('{{ section.settings.hero_bg | img_url: '2048x' }}'); background-position: 10% 100%; background-size: 100%;">
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative grid md:grid-cols-2 gap-8 items-center p-8 md:p-16">
          {%- comment -%} Left Content {%- endcomment -%}
          <div class="text-white">
            <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight font-heading">
              {{ section.settings.hero_title | default: "Coffee News & Updates" }}
            </h1>
            <p class="text-base md:text-lg leading-relaxed text-white/90 font-body">
              {{ section.settings.hero_description | default: "Stay updated with the latest coffee news, brewing techniques, roasting guides, and industry insights from Flores Island Coffee." }}
            </p>
          </div>

          {%- comment -%} Right Image {%- endcomment -%}
          <div class="flex justify-center items-center">
            {%- if section.settings.hero_image -%}
              <img
                src="{{ section.settings.hero_image | img_url: '800x' }}"
                alt="Coffee News"
                class="w-full max-w-md h-auto object-contain drop-shadow-2xl"
              >
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Blog Articles Section {%- endcomment -%}
  <section class="py-16 bg-white px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <h2 class="leading-relaxed md:leading-[33px] md:text-4xl font-extrabold text-flores-primary mb-12 font-heading">
        Latest Articles
      </h2>
      
      {%- if blog.articles_count > 0 -%}
      {%- comment -%} Articles Grid {%- endcomment -%}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {%- for article in blog.articles -%}
          <article class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
            {%- comment -%} Article Image {%- endcomment -%}
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" aria-label="Read {{ article.title }}">
                <img 
                  src="{{ article.image | img_url: '800x600', crop: 'center' }}" 
                  srcset="{{ article.image | img_url: '800x600', crop: 'center' }} 1x, {{ article.image | img_url: '1600x1200', crop: 'center' }} 2x"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="800"
                  height="600"
                  class="w-full h-64 object-cover hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                >
              </a>
            {%- else -%}
              <div class="w-full h-64 bg-gradient-to-br from-flores-primary/20 to-flores-primary/10 flex items-center justify-center">
                <svg class="w-16 h-16 text-flores-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
            {%- endif -%}
            
            {%- comment -%} Article Content {%- endcomment -%}
            <div class="p-6">
              {%- comment -%} Tags {%- endcomment -%}
              {%- if article.tags.size > 0 -%}
                <span class="inline-block bg-flores-light/30 text-flores-primary px-3 py-1 rounded-full text-sm font-medium mb-3 font-body">
                  {{ article.tags | first }}
                </span>
              {%- endif -%}
              
              {%- comment -%} Title {%- endcomment -%}
              <h2 class="text-xl font-bold text-gray-900 mb-3 font-heading line-clamp-2">
                <a href="{{ article.url }}" class="hover:text-flores-primary transition-colors">
                  {{ article.title }}
                </a>
              </h2>
              
              {%- comment -%} Meta Info {%- endcomment -%}
              <div class="flex items-center gap-3 text-sm text-gray-500 mb-3 font-body">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </time>
                {%- if article.author != blank -%}
                  <span>•</span>
                  <span>{{ article.author }}</span>
                {%- endif -%}
              </div>
              
              {%- comment -%} Excerpt {%- endcomment -%}
              <p class="text-gray-600 mb-4 font-body line-clamp-3">
                {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
              </p>
              
              {%- comment -%} Read More Link {%- endcomment -%}
              <a 
                href="{{ article.url }}"
                class="inline-flex items-center text-flores-primary font-semibold hover:text-flores-primary/80 transition-colors font-body"
                aria-label="Read more about {{ article.title }}"
              >
                Read More
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
        <nav class="flex justify-center items-center gap-2 mt-12" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="px-6 py-3 bg-white border-2 border-flores-primary text-flores-primary rounded-full font-semibold hover:bg-flores-primary hover:text-white transition-colors font-body">
              ← Previous
            </a>
          {%- endif -%}

          <div class="flex gap-2">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="w-12 h-12 flex items-center justify-center bg-white border-2 border-gray-300 rounded-full hover:border-flores-primary transition-colors font-body">
                  {{ part.title }}
                </a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="w-12 h-12 flex items-center justify-center bg-flores-primary text-white border-2 border-flores-primary rounded-full font-bold font-body">
                  {{ part.title }}
                </span>
              {%- else -%}
                <span class="w-12 h-12 flex items-center justify-center text-gray-400 font-body">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="px-6 py-3 bg-flores-primary text-white rounded-full font-semibold hover:bg-flores-primary/90 transition-colors font-body">
              Next →
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Empty State {%- endcomment -%}
      <div class="text-center py-16">
        <svg class="w-20 h-20 mx-auto mb-6 text-flores-primary/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h2 class="text-2xl font-bold text-flores-primary mb-3 font-heading">No articles yet</h2>
        <a href="/blogs/news" class="inline-flex items-center bg-flores-primary text-white px-8 py-3 rounded-full font-semibold hover:bg-flores-primary/90 transition-colors font-body">
          Browse All Articles
        </a>
      </div>
    {%- endif -%}
    </div>
  </section>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_bg",
      "label": "Hero Background Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Coffee News & Updates"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Stay updated with the latest coffee news, brewing techniques, roasting guides, and industry insights from Flores Island Coffee."
    }
  ]
}
{% endschema %}
