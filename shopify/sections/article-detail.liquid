{% comment %}
  Article Detail Section - Matching ReadNews.jsx structure exactly
  Features: Author badge, 2-column layout with sidebar, Latest articles section
{% endcomment %}

<div class="min-h-screen bg-white">
  {%- comment -%} Article Header and Content {%- endcomment -%}
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        {%- comment -%} Main Article Content - Left Side {%- endcomment -%}
        <div class="lg:col-span-2">
          {%- comment -%} Author Badge {%- endcomment -%}
          <div class="flex items-center gap-2 mb-6">
            <div class="bg-teal-700 text-white rounded-full px-3 py-1 flex items-center gap-2">
              <div class="w-6 h-6 bg-teal-600 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-xs font-medium">{{ article.author | default: "Admin" }}</span>
            </div>
          </div>

          {%- comment -%} Tags {%- endcomment -%}
          {%- if article.tags.size > 0 -%}
            <div class="flex flex-wrap gap-2 mb-6">
              {%- for tag in article.tags -%}
                <a 
                  href="{{ blog.url }}/tagged/{{ tag | handle }}"
                  class="inline-block bg-teal-50 text-teal-700 px-4 py-2 rounded-full text-sm font-medium hover:bg-teal-100 transition-colors"
                >
                  {{ tag }}
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Title {%- endcomment -%}
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-teal-800 mb-8">
            {{ article.title }}
          </h1>

          {%- comment -%} Featured Image {%- endcomment -%}
          {%- if article.image != blank -%}
            <div class="mb-4">
              <img
                src="{{ article.image | img_url: '1200x' }}"
                srcset="{{ article.image | img_url: '1200x' }} 1x, {{ article.image | img_url: '2400x' }} 2x"
                alt="{{ article.image.alt | default: article.title }}"
                class="w-full h-auto object-cover rounded-lg"
                loading="eager"
              >
            </div>
          {%- endif -%}

          {%- comment -%} Article Body {%- endcomment -%}
          <div class="prose prose-lg max-w-none mb-12 
                      prose-headings:font-serif prose-headings:font-bold prose-headings:text-gray-900 prose-headings:mt-8 prose-headings:mb-4 prose-headings:first:mt-0
                      prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg
                      prose-p:text-base prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-6
                      prose-a:text-teal-700 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
                      prose-strong:text-gray-900 prose-strong:font-semibold
                      prose-ul:my-6 prose-ul:list-disc prose-ul:pl-6 prose-li:text-gray-700 prose-li:mb-2
                      prose-ol:my-6 prose-ol:list-decimal prose-ol:pl-6
                      prose-blockquote:border-l-4 prose-blockquote:border-teal-700 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-gray-600
                      prose-img:rounded-xl prose-img:shadow-lg prose-img:my-8 prose-img:max-w-full prose-img:h-auto
                      prose-code:text-teal-700 prose-code:bg-teal-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                      prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:rounded-lg prose-pre:p-4
                      [&_img]:max-w-full [&_img]:h-auto [&_img]:mx-auto">
            {{ article.content | raw }}
          </div>

          {%- comment -%} Share Section {%- endcomment -%}
          <div class="border-t border-gray-200 pt-8">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <span class="text-base font-semibold text-teal-800">Share this article:</span>
              <div class="flex gap-3">
                {%- comment -%} Facebook {%- endcomment -%}
                <a 
                  href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
                  target="_blank"
                  rel="noopener"
                  class="w-12 h-12 flex items-center justify-center bg-[#1877f2] text-white rounded-full hover:opacity-80 transition-opacity shadow-lg"
                  aria-label="Share on Facebook"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>

                {%- comment -%} Twitter {%- endcomment -%}
                <a 
                  href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  class="w-12 h-12 flex items-center justify-center bg-[#1da1f2] text-white rounded-full hover:opacity-80 transition-opacity shadow-lg"
                  aria-label="Share on Twitter"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                </a>

                {%- comment -%} LinkedIn {%- endcomment -%}
                <a 
                  href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ article.url }}"
                  target="_blank"
                  rel="noopener"
                  class="w-12 h-12 flex items-center justify-center bg-[#0077b5] text-white rounded-full hover:opacity-80 transition-opacity shadow-lg"
                  aria-label="Share on LinkedIn"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>

                {%- comment -%} WhatsApp {%- endcomment -%}
                <a 
                  href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  class="w-12 h-12 flex items-center justify-center bg-[#25d366] text-white rounded-full hover:opacity-80 transition-opacity shadow-lg"
                  aria-label="Share on WhatsApp"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Related Content Sidebar - Right Side {%- endcomment -%}
        <div class="lg:col-span-1">
          <h2 class="text-2xl font-serif font-bold text-teal-800 mb-6">Related Content</h2>
          <div class="space-y-6">
            {%- comment -%} Get 3 related articles excluding current article {%- endcomment -%}
            {%- assign related_count = 0 -%}
            {%- for blog_article in blog.articles limit: 10 -%}
              {%- if blog_article.id != article.id and related_count < 3 -%}
                <a href="{{ blog_article.url }}" class="block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow group">
                  {%- if blog_article.image -%}
                    <img
                      src="{{ blog_article.image | img_url: '600x' }}"
                      alt="{{ blog_article.title }}"
                      class="w-full h-48 object-cover group-hover:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="w-full h-48 bg-gradient-to-br from-teal-100 to-cyan-100"></div>
                  {%- endif -%}
                  <div class="p-4">
                    {%- comment -%} Author Badge {%- endcomment -%}
                    <div class="flex items-center gap-2 mb-6">
                      <div class="bg-teal-700 text-white rounded-full px-3 py-1 flex items-center gap-2">
                        <div class="w-6 h-6 bg-teal-600 rounded-full flex items-center justify-center">
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                          </svg>
                        </div>
                        <span class="text-xs font-medium">{{ blog_article.author | default: "Admin" }}</span>
                      </div>
                    </div>
                    <h3 class="text-lg font-serif font-bold text-teal-800 group-hover:text-teal-700 transition-colors">
                      {{ blog_article.title }}
                    </h3>
                  </div>
                </a>
                {%- assign related_count = related_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Latest Articles Section {%- endcomment -%}
  <section class="py-20 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-center mb-12">
        <h2 class="text-4xl font-serif font-bold text-teal-800">Latest Articles</h2>
        <a href="{{ blog.url }}" class="text-teal-700 hover:text-teal-800 font-medium">
          See All
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {%- comment -%} Get 4 latest articles excluding current article {%- endcomment -%}
        {%- assign latest_count = 0 -%}
        {%- for blog_article in blog.articles limit: 15 -%}
          {%- if blog_article.id != article.id and latest_count < 4 -%}
            <a href="{{ blog_article.url }}" class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow group">
              {%- if blog_article.image -%}
                <img
                  src="{{ blog_article.image | img_url: '600x' }}"
                  alt="{{ blog_article.title }}"
                  class="w-full h-48 object-cover group-hover:scale-[1.02] transition-transform duration-300"
                  loading="lazy"
                >
              {%- else -%}
                <div class="w-full h-48 bg-gradient-to-br from-teal-100 to-cyan-100"></div>
              {%- endif -%}
              <div class="p-6">
                {%- comment -%} Author Badge {%- endcomment -%}
                <div class="flex items-center gap-2">
                  <div class="bg-teal-700 text-white rounded-full px-3 py-1 flex items-center gap-2">
                    <div class="w-6 h-6 bg-teal-600 rounded-full flex items-center justify-center">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium">{{ blog_article.author | default: "Admin" }}</span>
                  </div>
                </div>
                <h3 class="text-xl font-serif font-bold text-teal-800 mt-4 mb-2 group-hover:text-teal-700 transition-colors">
                  {{ blog_article.title }}
                </h3>
              </div>
            </a>
            {%- assign latest_count = latest_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Article Detail",
  "settings": []
}
{% endschema %}
