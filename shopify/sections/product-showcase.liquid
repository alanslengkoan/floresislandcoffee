{% comment %}
  Product Showcase Section - Display featured products
{% endcomment %}

<section class="py-20 bg-gray-50 mb-16">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-center mb-8 md:mb-16 leading-relaxed md:leading-[33px] md:text-4xl font-extrabold font-heading">
      {{ section.settings.title | default: 'Our Signature Coffee Product' }}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4 px-[60px]">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          {% render 'product-card',
            type: 'image',
            title: block.settings.title,
            subtitle: block.settings.subtitle,
            product_image: block.settings.product_image,
            background_img: block.settings.background_image,
            alt: block.settings.button_text,
            button_url: block.settings.button_url
          %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Our Signature Coffee Product"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
