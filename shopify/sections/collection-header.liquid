{% comment %}
  Collection Header Section
{% endcomment %}

<section class="relative h-[400px] bg-cover bg-center flex items-center justify-center" 
  style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url({% if collection.image %}{{ collection.image | img_url: '2048x800', crop: 'center' }}{% else %}https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=2048{% endif %});">
  <div class="text-center text-white z-10 px-6">
    <h1 class="text-4xl md:text-5xl font-bold mb-4 font-heading">
      {%- if collection.handle == 'all' -%}
        Our Coffee Products
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if collection.description != blank -%}
      <p class="text-lg md:text-xl max-w-2xl mx-auto font-body">
        {{ collection.description }}
      </p>
    {%- elsif collection.handle == 'all' -%}
      <p class="text-lg md:text-xl max-w-2xl mx-auto font-body">
        Explore our carefully curated coffee products from Flores Island
      </p>
    {%- endif -%}
    <p class="mt-4 text-sm font-body opacity-90">
      {{ collection.products_count }} {% if collection.products_count == 1 %}Product{% else %}Products{% endif %}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Collection Header",
  "settings": []
}
{% endschema %}
