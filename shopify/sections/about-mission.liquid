{% comment %}
  About Mission Section - Mission statement and values
{% endcomment %}

<section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-4xl lg:max-w-5xl mx-auto p-4 lg:p-12 bg-gradient-to-br from-blue-100/70 to-blue-200/50 rounded-lg shadow-xl">
    <div class="text-center mb-8 lg:mb-16">
      <h2 class="text-xl lg:text-4xl xl:text-5xl font-serif text-slate-700 mb-4 lg:mb-12 font-light">
        {{ section.settings.title | default: 'Mission Statement' }}
      </h2>
      <div class="space-y-3 lg:space-y-6 text-sm lg:text-xl xl:text-2xl text-slate-700 leading-relaxed max-w-3xl lg:max-w-4xl mx-auto">
        <p class="font-light">
          Within 3 years achieve the aggregation of coffee production from
          <span class="font-medium text-slate-800"> 3% of the 75,000 Flores smallholder coffee farmer households</span>, into
          a high quality, globally significant production centre, and to reach a
          target of <span class="font-medium text-slate-800">6% of these farmer households within 5 years</span>.
        </p>
      </div>
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-12 mt-6 lg:mt-16">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="text-center {% unless forloop.last %}lg:border-r-2 lg:pr-8{% endunless %}" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="w-20 h-20 mx-auto mb-6 flex items-center justify-center">
                  <img 
                    src="{{ block.settings.icon | img_url: '200x200' }}" 
                    alt="{{ block.settings.title }} {{ block.settings.subtitle }}"
                    width="80"
                    height="80"
                    class="w-full h-full object-contain"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <h3 class="text-base font-semibold text-slate-800 mb-2 leading-tight">{{ block.settings.title }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p class="text-sm text-slate-700 font-medium">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Mission",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Mission Statement"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission text"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Mission",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Ethical Labour &<br>Gender Neutral",
            "subtitle": "Practices"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Deforestation",
            "subtitle": "Free"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Biodiversity &<br>Ecosystem Services",
            "subtitle": ""
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Emissions & Circular",
            "subtitle": "Economy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
