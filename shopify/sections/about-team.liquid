{% comment %}
  About Team Section - Team members and leadership
{% endcomment %}

{%- comment -%} Our Team {%- endcomment -%}
<section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-serif text-teal-800 text-center mb-12">
      {{ section.settings.team_title | default: 'Our Team' }}
    </h2>
    
    {%- if section.blocks.size > 0 -%}
      <div class="grid grid-cols-2 md:grid-cols-5 lg:grid-cols-5 gap-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'team_member' -%}
            <div class="text-center" {{ block.shopify_attributes }}>
              {%- if block.settings.photo != blank -%}
                <img 
                  src="{{ block.settings.photo | img_url: '400x400' }}" 
                  alt="{{ block.settings.name }}, {{ block.settings.position }}"
                  width="400"
                  height="400"
                  class="w-full aspect-square object-cover rounded-lg mb-4"
                  loading="lazy"
                >
              {%- else -%}
                <div class="w-full aspect-square bg-gradient-to-br from-blue-100 to-teal-100 rounded-lg mb-4"></div>
              {%- endif -%}
              <h3 class="font-semibold text-gray-900 text-sm">{{ block.settings.name }}</h3>
              {%- if block.settings.position != blank -%}
                <p class="text-xs text-gray-600">{{ block.settings.position }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Our Brand & Strategic Partnership {%- endcomment -%}
<section class="py-12 lg:py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-12">
    <div class="text-center md:border-r md:border-gray-500 md:pr-6">
      <h2 class="text-xl lg:text-4xl xl:text-5xl font-serif text-slate-700 mb-4 lg:mb-12 font-light">
        {{ section.settings.brand_title | default: 'Our Brand' }}
      </h2>
      <div class="flex flex-row gap-4 justify-center items-center">
        {%- if section.settings.brand_logo_2 != blank -%}
          <img 
            src="{{ section.settings.brand_logo_2 | img_url: '200x200' }}" 
            alt="Our Brand Logo"
            width="120"
            height="120"
            class="max-w-[120px] md:max-w-40 w-full h-auto object-contain"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.brand_logo_1 != blank -%}
          <img 
            src="{{ section.settings.brand_logo_1 | img_url: '200x200' }}" 
            alt="Our Brand Logo"
            width="120"
            height="120"
            class="max-w-[120px] md:max-w-40 w-full h-auto object-contain"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
    <div class="text-center md:pl-6">
      <h2 class="text-xl lg:text-4xl xl:text-5xl font-serif text-slate-700 mb-4 lg:mb-12 font-light">
        {{ section.settings.partnership_title | default: 'Strategic Partnership' }}
      </h2>
      <div class="flex flex-row gap-4 justify-center items-center">
        {%- if section.settings.partner_logo_1 != blank -%}
          <img 
            src="{{ section.settings.partner_logo_1 | img_url: '200x200' }}" 
            alt="Strategic Partnership Logo"
            width="120"
            height="120"
            class="max-w-[120px] md:max-w-40 w-full h-auto object-contain"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.partner_logo_2 != blank -%}
          <img 
            src="{{ section.settings.partner_logo_2 | img_url: '200x200' }}" 
            alt="Strategic Partnership Logo"
            width="120"
            height="120"
            class="max-w-[120px] md:max-w-40 w-full h-auto object-contain"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

