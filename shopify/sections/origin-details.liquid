<section class="py-16 md:py-20 flex justify-center">
  <div class="max-w-7xl mx-auto px-6 md:px-12 bg-[#E8F4F4] rounded-lg space-y-16 md:space-y-20 py-12 md:py-16">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-flores-primary mb-8 font-heading">
          {{ section.settings.arabica_title }}
        </h2>
        <div class="grid grid-cols-2 gap-4">
          {% assign varieties = section.settings.arabica_varieties | split: "," %}
          {% for variety in varieties %}
            <div class="flex items-center gap-3 bg-white p-3 rounded-lg shadow-sm">
              <div class="w-6 h-6 rounded-full bg-flores-primary flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-sm md:text-base text-flores-primary font-body">{{ variety }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
      <div>
        {%- if section.settings.arabica_image != blank -%}
          <img
            src="{{ section.settings.arabica_image | img_url: '800x' }}"
            alt="{{ section.settings.arabica_image_alt }}"
            class="w-full rounded-lg shadow-lg"
          />
        {%- endif -%}
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        {%- if section.settings.flores_image != blank -%}
          <img
            src="{{ section.settings.flores_image | img_url: '800x' }}"
            alt="{{ section.settings.flores_image_alt }}"
            class="w-full rounded-lg shadow-lg"
          />
        {%- endif -%}
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-flores-primary mb-6 font-heading">
          {{ section.settings.flores_title }}
        </h2>
        <div class="space-y-4">
          <p class="text-base md:text-lg leading-relaxed text-[#476472] font-body">
            {{ section.settings.flores_description }}
          </p>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-flores-primary mb-6 font-heading">
          {{ section.settings.snapshot_title }}
        </h2>
        <div class="space-y-4">
          <p class="text-base md:text-lg leading-relaxed text-[#476472] font-body">
            {{ section.settings.snapshot_description }}
          </p>
        </div>
      </div>
      <div>
        {%- if section.settings.snapshot_image != blank -%}
          <img
            src="{{ section.settings.snapshot_image | img_url: '800x' }}"
            alt="{{ section.settings.snapshot_image_alt }}"
            class="w-full rounded-lg shadow-lg"
          />
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Origin Details",
  "settings": [
    {
      "type": "text",
      "id": "arabica_title",
      "label": "Arabica Varieties Title",
      "default": "Common Arabica Varieties"
    },
    {
      "type": "textarea",
      "id": "arabica_varieties",
      "label": "Arabica Varieties (comma separated)",
      "default": "Abyssinia,S-795,Ateng,Typica,Sigararutang,Andungsari,Catimors,Tim-Tim (Timor Hybrid)",
      "info": "Separate each variety with a comma"
    },
    {
      "type": "image_picker",
      "id": "arabica_image",
      "label": "Arabica Varieties Image"
    },
    {
      "type": "text",
      "id": "arabica_image_alt",
      "label": "Arabica Image Alt Text",
      "default": "Coffee Varieties"
    },
    {
      "type": "text",
      "id": "flores_title",
      "label": "Flores Island Title",
      "default": "Flores Island"
    },
    {
      "type": "textarea",
      "id": "flores_description",
      "label": "Flores Island Description",
      "default": "The name Flores is from \"Cabo de Flores\" - Cape of Flowers - used by Portuguese sailors in the 17th century. 570 kms long and located 300 kms to the east of Bali, Flores is home to exotic tropical fruits, spices and creatures, high mountain ranges and volcanoes surrounded by some of the world's best coral reefs. Flores Island is populated by various ethnic groups with their own traditions and languages within a total island wide population of around 2 million."
    },
    {
      "type": "image_picker",
      "id": "flores_image",
      "label": "Flores Island Image"
    },
    {
      "type": "text",
      "id": "flores_image_alt",
      "label": "Flores Image Alt Text",
      "default": "Flores Island"
    },
    {
      "type": "text",
      "id": "snapshot_title",
      "label": "Coffee Snapshot Title",
      "default": "Coffee Snapshot"
    },
    {
      "type": "textarea",
      "id": "snapshot_description",
      "label": "Coffee Snapshot Description",
      "default": "The island of Flores has produced significant volumes of coffee for well over a century. Arabica coffee is grown at 1,200 to 1,800 metres above sea level. Flores coffee cultivation covers more than 72,000 hectares of Robusta and Arabica species from the western part (Labuan Bajo) to the eastern end (Maumere). Most coffee is grown under shade trees without chemicals and is known for sweet chocolate, floral and woody notes. Kartika is the most common arabica variety along with Yellow Colombian, Lini S, Red Columbian, and Juria."
    },
    {
      "type": "image_picker",
      "id": "snapshot_image",
      "label": "Coffee Snapshot Image"
    },
    {
      "type": "text",
      "id": "snapshot_image_alt",
      "label": "Snapshot Image Alt Text",
      "default": "Coffee Snapshot"
    }
  ],
  "presets": [
    {
      "name": "Origin Details"
    }
  ]
}
{% endschema %}
