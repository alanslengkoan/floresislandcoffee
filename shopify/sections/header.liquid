{% comment %}
  Header Section - Converted from RootLayout.jsx
  Sticky navigation with scroll effect
{% endcomment %}

<header 
  id="shopify-section-header" 
  x-data="{ 
    mobileMenuOpen: false, 
    isScrolled: false
  }"
  x-init="window.addEventListener('scroll', () => { isScrolled = window.scrollY > 50; })"
  x-effect="document.body.style.overflow = mobileMenuOpen ? 'hidden' : ''"
  x-bind:class="isScrolled ? 'fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-lg' : 'fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white border-b border-gray-200'"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white border-b border-gray-200"
>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between px-3 py-2 lg:px-4">
    
    {%- comment -%} Logo {%- endcomment -%}
    <div class="flex">
      <a href="/" class="-m-1.5 p-1.5" aria-label="Homepage - {{ shop.name }}">
        <span class="sr-only">{{ shop.name }}</span>
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_width = section.settings.logo_width | default: 100
            assign logo_height = logo_width | times: 0.5 | round
          -%}
          <img
            src="{{ section.settings.logo | img_url: width: 200 }}"
            srcset="{{ section.settings.logo | img_url: width: 200 }} 1x, {{ section.settings.logo | img_url: width: 400 }} 2x"
            alt="{{ shop.name }}"
            width="{{ logo_width }}"
            height="{{ logo_height }}"
            class="h-12 w-auto"
            loading="eager"
            style="height: 52px;"
          >
        {%- else -%}
          <span class="text-2xl font-bold text-flores-primary font-heading">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Mobile menu button and cart {%- endcomment -%}
    <div class="flex lg:hidden items-center gap-4">
      <a
        href="/cart"
        class="relative text-flores-primary hover:text-flores-primary/80"
      >
        <span class="sr-only">Shopping cart</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </a>
      <button
        type="button"
        @click="mobileMenuOpen = true"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-flores-primary"
        aria-label="Open main menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <div class="hidden lg:flex lg:flex-1 lg:justify-end items-center gap-x-6">
      {%- comment -%} Navigation Links {%- endcomment -%}
      <div class="flex gap-x-6">
        {% assign current_path = request.path %}
        {% assign is_about_active = false %}
        {% if current_path == '/pages/about' or template.name == 'page.about' %}
          {% assign is_about_active = true %}
        {% endif %}
        <a 
          href="/pages/about" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body {% if is_about_active %}bg-flores-primary !text-white{% else %}text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20{% endif %}"
        >
          About Us
        </a>
        {% assign is_shop_active = false %}
        {% if template.name == 'collection' or template.name == 'product' %}
          {% assign is_shop_active = true %}
        {% endif %}
        <a 
          href="/collections/all" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body {% if is_shop_active %}bg-flores-primary !text-white{% else %}text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20{% endif %}"
        >
          Shop
        </a>
        {% assign is_news_active = false %}
        {% if template.name == 'article' or template.name == 'blog' %}
          {% assign is_news_active = true %}
        {% endif %}
        <a 
          href="/blogs/news" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body {% if is_news_active %}bg-flores-primary !text-white{% else %}text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20{% endif %}"
        >
          News
        </a>
        {% assign is_contact_active = false %}
        {% if current_path == '/pages/contact' or template.name == 'page.contact' %}
          {% assign is_contact_active = true %}
        {% endif %}
        <a 
          href="/pages/contact" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body {% if is_contact_active %}bg-flores-primary !text-white{% else %}text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20{% endif %}"
        >
          Contact
        </a>
      </div>

      {%- comment -%} Icons {%- endcomment -%}
      <div class="flex items-center gap-x-4 ml-4">
        <a
          href="/cart"
          class="relative text-flores-primary hover:text-flores-primary/80"
        >
          <span class="sr-only">Shopping cart</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
              {{ cart.item_count }}
            </span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </nav>

  {%- comment -%} Mobile Menu Overlay & Panel {%- endcomment -%}
  <template x-if="mobileMenuOpen">
    <div class="lg:hidden">
      {%- comment -%} Dark Backdrop {%- endcomment -%}
      <div 
        @click="mobileMenuOpen = false"
        style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9998; background-color: rgba(0, 0, 0, 0.5);"
      ></div>
      
      {%- comment -%} White Menu Panel {%- endcomment -%}
      <div style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100vh; z-index: 9999; background: #ffffff; display: flex; flex-direction: column; overflow: hidden;">
        
        {%- comment -%} Menu Header {%- endcomment -%}
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border-bottom: 1px solid #e5e7eb; background-color: #ffffff; flex-shrink: 0;">
          <a href="/" @click="mobileMenuOpen = false" style="text-decoration: none;">
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | img_url: 'small' }}" alt="{{ shop.name }}" style="height: 52px; width: auto;">
            {%- else -%}
              <span style="font-size: 1.25rem; font-weight: bold; color: #005E75;">{{ shop.name }}</span>
            {%- endif -%}
          </a>
          <button
            type="button"
            @click="mobileMenuOpen = false"
            style="padding: 0.625rem; color: #005E75; background: none; border: none; cursor: pointer;"
            aria-label="Close menu"
          >
            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        {%- comment -%} Menu Links {%- endcomment -%}
        <div style="flex: 1 1 auto; overflow-y: auto; overflow-x: hidden; padding: 1.5rem 1rem; background-color: #ffffff; min-height: 0;">
          <nav>
            <a 
              href="/pages/about" 
              @click="mobileMenuOpen = false"
              style="display: block; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; font-size: 1rem; font-weight: 600; color: #005E75; text-decoration: none; transition: background-color 0.2s;"
              onmouseover="this.style.backgroundColor='rgba(0, 94, 117, 0.1)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              About Us
            </a>
            <a 
              href="/collections/all" 
              @click="mobileMenuOpen = false"
              style="display: block; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; font-size: 1rem; font-weight: 600; color: #005E75; text-decoration: none; transition: background-color 0.2s;"
              onmouseover="this.style.backgroundColor='rgba(0, 94, 117, 0.1)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              Shop
            </a>
            <a 
              href="/blogs/news" 
              @click="mobileMenuOpen = false"
              style="display: block; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; font-size: 1rem; font-weight: 600; color: #005E75; text-decoration: none; transition: background-color 0.2s;"
              onmouseover="this.style.backgroundColor='rgba(0, 94, 117, 0.1)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              News
            </a>
            <a 
              href="/pages/contact" 
              @click="mobileMenuOpen = false"
              style="display: block; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 0.5rem; font-size: 1rem; font-weight: 600; color: #005E75; text-decoration: none; transition: background-color 0.2s;"
              onmouseover="this.style.backgroundColor='rgba(0, 94, 117, 0.1)'"
              onmouseout="this.style.backgroundColor='transparent'"
            >
              Contact
            </a>
          </nav>
        </div>

      </div>
    </div>
  </template>

</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    }
  ]
}
{% endschema %}
