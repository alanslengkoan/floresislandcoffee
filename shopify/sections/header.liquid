{% comment %}
  Header Section - Converted from RootLayout.jsx
  Sticky navigation with scroll effect
{% endcomment %}

<header 
  id="shopify-section-header" 
  x-data="{ 
    mobileMenuOpen: false, 
    isScrolled: false
  }"
  x-init="window.addEventListener('scroll', () => { isScrolled = window.scrollY > 50; })"
  x-bind:class="isScrolled ? 'sticky top-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-white/20 shadow-lg' : 'sticky top-0 z-50 transition-all duration-300 bg-white border-b border-gray-200'"
  class="sticky top-0 z-50 transition-all duration-300 bg-white border-b border-gray-200"
>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between px-3 py-2 lg:px-4">
    
    {%- comment -%} Logo {%- endcomment -%}
    <div class="flex">
      <a href="/" class="-m-1.5 p-1.5" aria-label="Homepage - {{ shop.name }}">
        <span class="sr-only">{{ shop.name }}</span>
        {%- if section.settings.logo != blank -%}
          {%- liquid
            assign logo_width = section.settings.logo_width | default: 100
            assign logo_height = logo_width | times: 0.5 | round
          -%}
          <img
            src="{{ section.settings.logo | img_url: width: 200 }}"
            srcset="{{ section.settings.logo | img_url: width: 200 }} 1x, {{ section.settings.logo | img_url: width: 400 }} 2x"
            alt="{{ shop.name }}"
            width="{{ logo_width }}"
            height="{{ logo_height }}"
            class="h-12 w-auto"
            loading="eager"
            style="height: 52px;"
          >
        {%- else -%}
          <span class="text-2xl font-bold text-flores-primary font-heading">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Mobile menu button and cart {%- endcomment -%}
    <div class="flex lg:hidden items-center gap-4">
      <a
        href="/cart"
        class="relative text-flores-primary hover:text-flores-primary/80"
      >
        <span class="sr-only">Shopping cart</span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </a>
      <button
        type="button"
        @click="mobileMenuOpen = true"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-flores-primary"
        aria-label="Open main menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <div class="hidden lg:flex lg:flex-1 lg:justify-end items-center gap-x-6">
      {%- comment -%} Navigation Links {%- endcomment -%}
      <div class="flex gap-x-6">
        {% assign current_path = request.path %}
        <a 
          href="/pages/about" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20 {% if current_path == '/pages/about' or template.name == 'page.about' %}bg-flores-primary !text-white{% endif %}"
        >
          About Us
        </a>
        <a 
          href="/collections/all" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20 {% if template.name == 'collection' or template.name == 'product' %}bg-flores-primary !text-white{% endif %}"
        >
          Shop
        </a>
        <a 
          href="/blogs/news" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20 {% if template.name == 'article' or template.name == 'blog' %}bg-flores-primary !text-white{% endif %}"
        >
          News
        </a>
        <a 
          href="/pages/contact" 
          class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20 {% if current_path == '/pages/contact' or template.name == 'page.contact' %}bg-flores-primary !text-white{% endif %}"
        >
          Contact
        </a>
      </div>

      {%- comment -%} Icons {%- endcomment -%}
      <div class="flex items-center gap-x-4 ml-4">
        <a
          href="/cart"
          class="relative text-flores-primary hover:text-flores-primary/80"
        >
          <span class="sr-only">Shopping cart</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
              {{ cart.item_count }}
            </span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </nav>

  {%- comment -%} Mobile Navigation Menu {%- endcomment -%}
  <div 
    x-show="mobileMenuOpen"
    @click.self="mobileMenuOpen = false"
    class="lg:hidden fixed inset-0 z-50"
    style="display: none;"
  >
    {%- comment -%} Backdrop Overlay {%- endcomment -%}
    <div 
      x-show="mobileMenuOpen"
      x-transition:enter="transition-opacity ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-40 bg-black/25"
    ></div>
    
    {%- comment -%} Menu Panel {%- endcomment -%}
    <div 
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-300 transform"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
      class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-white px-4 py-4 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10"
    >
      <div class="flex items-center justify-between">
        <a href="/" class="-m-1.5 p-1.5" @click="mobileMenuOpen = false">
          <span class="sr-only">{{ shop.name }}</span>
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | img_url: 'small' }}" alt="{{ shop.name }}" class="h-12 w-auto" style="height: 52px;">
          {%- else -%}
            <span class="text-xl font-bold text-flores-primary font-heading">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <button
          type="button"
          @click="mobileMenuOpen = false"
          class="-m-2.5 rounded-md p-2.5 text-flores-primary"
          aria-label="Close menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-gray-500/10">
          <div class="space-y-2 py-4">
            <a 
              href="/pages/about" 
              @click="mobileMenuOpen = false"
              class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20 transform transition-all duration-500 ease-out"
              x-bind:class="mobileMenuOpen ? 'translate-x-0 opacity-100' : 'translate-x-8 opacity-0'"
              x-bind:style="mobileMenuOpen ? 'transition-delay: 200ms' : 'transition-delay: 0ms'"
            >
              About Us
            </a>
            <a 
              href="/collections/all" 
              @click="mobileMenuOpen = false"
              class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20 transform transition-all duration-500 ease-out"
              x-bind:class="mobileMenuOpen ? 'translate-x-0 opacity-100' : 'translate-x-8 opacity-0'"
              x-bind:style="mobileMenuOpen ? 'transition-delay: 300ms' : 'transition-delay: 0ms'"
            >
              Shop
            </a>
            <a 
              href="/blogs/news" 
              @click="mobileMenuOpen = false"
              class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20 transform transition-all duration-500 ease-out"
              x-bind:class="mobileMenuOpen ? 'translate-x-0 opacity-100' : 'translate-x-8 opacity-0'"
              x-bind:style="mobileMenuOpen ? 'transition-delay: 400ms' : 'transition-delay: 0ms'"
            >
              News
            </a>
            <a 
              href="/pages/contact" 
              @click="mobileMenuOpen = false"
              class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20 transform transition-all duration-500 ease-out"
              x-bind:class="mobileMenuOpen ? 'translate-x-0 opacity-100' : 'translate-x-8 opacity-0'"
              x-bind:style="mobileMenuOpen ? 'transition-delay: 500ms' : 'transition-delay: 0ms'"
            >
              Contact
            </a>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    }
  ]
}
{% endschema %}
