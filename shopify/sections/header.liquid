{% comment %}
  Header Section - Converted from RootLayout.jsx
  Sticky navigation with scroll effect
{% endcomment %}

<header 
  id="shopify-section-header" 
  class="sticky top-0 z-50 transition-all duration-300 bg-white border-b border-gray-200"
  x-data="{ 
    mobileMenuOpen: false, 
    isScrolled: false,
    init() {
      window.addEventListener('scroll', () => {
        this.isScrolled = window.scrollY > 50;
      });
    }
  }"
  :class="isScrolled ? 'bg-white/80 backdrop-blur-md border-b border-white/20 shadow-lg' : 'bg-white border-b border-gray-200'"
>
  <nav aria-label="Global" class="mx-auto flex max-w-7xl items-center justify-between px-3 py-2 lg:px-4">
    
    {%- comment -%} Logo {%- endcomment -%}
    <div class="flex">
      <a href="/" class="-m-1.5 p-1.5">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | img_url: 'medium' }}"
            alt="{{ shop.name }}"
            class="h-13 w-auto"
            loading="lazy"
          >
        {%- else -%}
          <span class="text-2xl font-bold text-flores-primary font-heading">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Mobile menu button {%- endcomment -%}
    <div class="flex lg:hidden">
      <button
        type="button"
        @click="mobileMenuOpen = true"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-flores-primary"
        aria-label="Open main menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <div class="hidden lg:flex lg:flex-1 lg:justify-end items-center gap-x-6">
      {%- comment -%} Navigation Links {%- endcomment -%}
      <div class="flex gap-x-6">
        <a href="/pages/about" class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20">
          About Us
        </a>
        <a href="/collections" class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20">
          Product
        </a>
        <a href="/blogs/news" class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20">
          News
        </a>
        <a href="/pages/contact" class="text-base font-semibold leading-6 transition-colors duration-200 px-4 py-2 rounded-md font-body text-flores-primary hover:text-flores-primary/80 hover:bg-flores-light/20">
          Contact
        </a>
      </div>

      {%- comment -%} Icons {%- endcomment -%}
      <div class="flex items-center gap-x-4 ml-4">
        <a href="/account" class="text-flores-primary hover:text-flores-primary/80">
          <span class="sr-only">Profile</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </a>
        <button type="button" class="text-flores-primary hover:text-flores-primary/80" onclick="document.querySelector('.search-modal').style.display='flex'">
          <span class="sr-only">Search</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  {%- comment -%} Mobile Navigation Menu {%- endcomment -%}
  <div 
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="lg:hidden fixed inset-0 z-50"
    style="display: none;"
  >
    <div class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-white px-4 py-4 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10">
      <div class="flex items-center justify-between">
        <a href="/" class="-m-1.5 p-1.5" @click="mobileMenuOpen = false">
          <span class="sr-only">{{ shop.name }}</span>
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | img_url: 'small' }}" alt="{{ shop.name }}" class="h-10 w-auto">
          {%- else -%}
            <span class="text-xl font-bold text-flores-primary font-heading">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <button
          type="button"
          @click="mobileMenuOpen = false"
          class="-m-2.5 rounded-md p-2.5 text-flores-primary"
          aria-label="Close menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-gray-500/10">
          <div class="space-y-2 py-4">
            <a href="/pages/about" class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20">About Us</a>
            <a href="/collections" class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20">Product</a>
            <a href="/blogs/news" class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20">News</a>
            <a href="/pages/contact" class="block rounded-lg py-2 px-3 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20">Contact</a>
          </div>
          <div class="py-4">
            <a href="/account" class="-mx-3 flex items-center gap-x-3 rounded-lg px-3 py-2.5 text-base font-semibold leading-7 font-body text-flores-primary hover:bg-flores-light/20">
              <svg class="h-6 w-6 text-flores-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
              Profile
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo width"
    }
  ]
}
{% endschema %}
