{% comment %}
  Coffee Origin Section - For Home Page
  Two-column layout with text and image
{% endcomment %}

<section class="flex flex-col lg:flex-row items-stretch min-h-screen">
  {%- comment -%} Left Panel {%- endcomment -%}
  <div class="bg-sustainability-bg w-full lg:w-[45%] flex flex-col justify-center px-8 lg:px-20 py-16">
    <h3 class="text-sustainability-text text-lg font-semibold mb-6 tracking-wide">
      {{ section.settings.subtitle | default: 'COFFEE ORIGIN' }}
    </h3>
    <h2 class="text-sustainability-text text-3xl md:text-4xl lg:text-5xl font-bold leading-relaxed md:leading-snug mb-8">
      {{ section.settings.title | default: 'Born in Flores,<br />Shared with the World' }}
    </h2>
    <p class="text-sustainability-desc text-lg leading-relaxed mb-10 max-w-lg">
      {{ section.settings.description | default: 'Hand-picked and processed with care — using wet-hulled and natural methods — Flores coffee reflects the craft and commitment of smallholder farmers.' }}
    </p>
    {%- if section.settings.button_url != blank -%}
      <a 
        href="{{ section.settings.button_url }}"
        class="bg-sustainability-btn hover:bg-sustainability-btn-hover text-white text-sm px-8 py-3 rounded-md font-medium transition-colors duration-300 w-fit inline-block"
      >
        {{ section.settings.button_text | default: 'Find Out More' }}
      </a>
    {%- else -%}
      <button class="bg-sustainability-btn hover:bg-sustainability-btn-hover text-white text-sm px-8 py-3 rounded-md font-medium transition-colors duration-300 w-fit">
        {{ section.settings.button_text | default: 'Find Out More' }}
      </button>
    {%- endif -%}
  </div>

  {%- comment -%} Right Image {%- endcomment -%}
  <div class="w-full lg:w-[55%] h-[400px] lg:h-auto">
    {%- if section.settings.image != blank -%}
      <img 
        src="{{ section.settings.image | img_url: '1200x800' }}" 
        alt="{{ section.settings.image_alt | default: 'Flores Island landscape' }}" 
        class="w-full h-full object-cover object-right" 
        loading="lazy"
      >
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coffee Origin",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "COFFEE ORIGIN"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title (HTML allowed)",
      "default": "Born in Flores,<br />Shared with the World"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-picked and processed with care — using wet-hulled and natural methods — Flores coffee reflects the craft and commitment of smallholder farmers."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Find Out More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Coffee Origin"
    }
  ]
}
{% endschema %}

