{% comment %}
  Coffee Origin Section - Sustainability Section from Home.jsx
  Two-column layout with text and image
{% endcomment %}

<section class="py-20 bg-gradient-to-br from-flores-separator to-flores-light/30">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <h1 class="text-3xl mb-4 font-semibold">{{ section.settings.subtitle | default: 'COFFEE ORIGIN' }}</h1>
        <h2 class="text-5xl font-bold text-flores-primary mb-8 font-heading">
          {{ section.settings.title | default: 'Born in Flores, Shared with the World' }}
        </h2>
        <p class="text-xl text-flores-primary/80 mb-8 leading-relaxed font-body">
          {{ section.settings.description | default: 'Hand-picked and processed with care — using wet-hulled and natural methods — Flores coffee reflects the craft and commitment of smallholder farmers.' }}
        </p>
        {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
          <a 
            href="{{ section.settings.button_url }}" 
            class="bg-flores-primary hover:bg-flores-primary/90 text-white px-8 py-4 rounded-full font-medium transition-colors duration-300 font-body inline-block"
          >
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
      <div class="relative">
        {%- if section.settings.image != blank -%}
          <img 
            src="{{ section.settings.image | img_url: 'large' }}" 
            alt="{{ section.settings.image_alt | default: 'Flores Island landscape' }}" 
            class="w-full h-80 object-cover rounded-3xl shadow-2xl" 
            loading="lazy"
          >
        {%- else -%}
          <div class="w-full h-80 bg-gray-200 rounded-3xl shadow-2xl flex items-center justify-center">
            <span class="text-gray-400">Image placeholder</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coffee Origin",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "COFFEE ORIGIN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Born in Flores, Shared with the World"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-picked and processed with care — using wet-hulled and natural methods — Flores coffee reflects the craft and commitment of smallholder farmers."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Coffee Origin"
    }
  ]
}
{% endschema %}
