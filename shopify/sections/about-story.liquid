{% comment %}
  About Story Section - Flores Island introduction
{% endcomment %}

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-serif text-teal-800 mb-2">{{ section.settings.location_title | default: 'FLORES ISLAND' }}</h2>
      <p class="text-xl text-teal-600">{{ section.settings.location_subtitle | default: 'INDONESIA' }}</p>
    </div>
    
    {%- if section.settings.map_image != blank -%}
      <div class="mb-16">
        <div class="bg-gradient-to-br from-blue-100 to-teal-100 rounded-lg p-8 mb-8">
          <img 
            src="{{ section.settings.map_image | img_url: 'large' }}" 
            alt="Flores Island Map"
            class="w-full h-64 md:h-80 object-contain rounded-lg"
            loading="lazy"
          >
        </div>
      </div>
    {%- endif -%}
    
    <div class="max-w-4xl mx-auto space-y-6 text-gray-600 leading-relaxed">
      <p class="text-lg">
        {{ section.settings.paragraph_1 | default: 'Flores Island Coffee (FIC) is a strategic partnership between New Zealand and Indonesia, driving sustainable growth in the Flores coffee industry.' }}
      </p>
      
      <p class="text-lg">
        {{ section.settings.paragraph_2 | default: "The venture is led by Old Station Road Limited (New Zealand), a brand owner and investor in agriculture, food, and beverages, together with Kopdit Pintu Air, Indonesia's largest cooperative credit union with 370,000+ members, including 222,000 smallholder farmers managing around 400,000 hectares of land." }}
      </p>
      
      <p class="text-lg">
        {{ section.settings.paragraph_3 | default: 'Based in Maumere, East Flores, FIC works closely with farming communities across Mt. Egon and Nilo, building a vertically integrated, sustainable coffee supply chain that delivers global impact while empowering local farmers.' }}
      </p>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            <div class="aspect-square" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img 
                  src="{{ block.settings.image | img_url: 'large' }}" 
                  alt="{{ block.settings.alt }}" 
                  class="w-full h-full object-cover rounded-lg"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "About Story",
  "settings": [
    {
      "type": "text",
      "id": "location_title",
      "label": "Location title",
      "default": "FLORES ISLAND"
    },
    {
      "type": "text",
      "id": "location_subtitle",
      "label": "Location subtitle",
      "default": "INDONESIA"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map image"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1"
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2"
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
