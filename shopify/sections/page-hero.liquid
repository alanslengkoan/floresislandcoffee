{% comment %}
  Page Hero Section - Generic hero for pages
{% endcomment %}

<section class="py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center my-8 md:my-16 px-6 md:px-[114px]">
      {%- if section.settings.subtitle != blank -%}
        <h2 class="text-sm lg:text-xl font-medium tracking-wide text-flores-primary uppercase mb-8 font-heading">
          {{ section.settings.subtitle }}
        </h2>
      {%- endif -%}
      
      <h1 class="text-xl md:text-4xl lg:text-4xl font-bold mb-6 tracking-tight font-heading leading-tight">
        {{ section.settings.title | default: page.title }}
      </h1>
    </div>
  </div>
</section>

{%- if section.settings.hero_image != blank -%}
<div class="min-h-screen">
  <section class="relative h-screen bg-cover bg-center bg-no-repeat" style="background-image: url({{ section.settings.hero_image | img_url: '2048x2048' }})">
  </section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "The richness of Flores coffee echoes the depth of its emerald hills and ocean skies."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Full screen hero image"
    }
  ],
  "presets": [
    {
      "name": "Page Hero"
    }
  ]
}
{% endschema %}
