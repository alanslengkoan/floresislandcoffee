{% comment %}
  Hero Home Section - Converted from Home.jsx
  Full-screen hero with background image and coffee icon
{% endcomment %}

<section 
  class="relative bg-cover bg-center bg-no-repeat -mt-20" 
  style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url({{ section.settings.hero_image | img_url: '2048x2048' }}); height: 100vh; padding-top: 5rem;" 
>
  <div class="absolute inset-0 flex items-center justify-center text-center text-white">
    <div class="max-w-4xl px-6 hero-content">
      {%- comment -%} Coffee Bean Icon {%- endcomment -%}
      <div class="mb-8">
        <div class="w-20 h-20 mx-auto mb-6 flex items-center justify-center">
          {%- if section.settings.coffee_icon != blank -%}
            <img 
              src="{{ section.settings.coffee_icon | img_url: '200x200' }}" 
              alt="Flores Island Coffee Logo - Premium Indonesian Coffee"
              loading="eager"
            >
          {%- endif -%}
        </div>
      </div>
      
      <h1 class="text-xl md:text-4xl lg:text-4xl font-bold mb-6 tracking-tight font-heading leading-tight">
        {{ section.settings.hero_title | default: 'Premium Flores Island Coffee - The richness echoes the depth of emerald hills and ocean skies' }}
      </h1>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Home",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "image_picker",
      "id": "coffee_icon",
      "label": "Coffee icon"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Premium Flores Island Coffee - The richness echoes the depth of emerald hills and ocean skies"
    }
  ],
  "presets": [
    {
      "name": "Hero Home"
    }
  ]
}
{% endschema %}
